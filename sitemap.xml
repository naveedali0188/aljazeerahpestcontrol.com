/* ==========================================================================
   Al Jazeerah Pest Control LLC — redesign
   Palette: green #218C43 · navy/teal #00384B · white · neutral #F5F7F4 · ink #252B2D
   ========================================================================== */

:root {
  --green: #218C43;
  --green-dark: #1A7136;
  --green-soft: #E9F5ED;
  --navy: #00384B;
  --navy-deep: #002B3B;
  --white: #FFFFFF;
  --neutral: #F5F7F4;
  --ink: #252B2D;
  --ink-soft: #4A5457;
  --line: #E4E9E4;
  --wa: #0E6E62;
  --wa-dark: #0B5A4F;
  --danger: #C0392B;
  --radius: 18px;
  --radius-lg: 24px;
  --shadow-sm: 0 2px 10px rgba(0, 56, 75, 0.07);
  --shadow-md: 0 14px 34px rgba(0, 56, 75, 0.12);
  --container: 1200px;
  --header-h: 78px;
  --font-body: "Poppins", "Segoe UI", Tahoma, Arial, sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink);
  background: var(--white);
  overflow-x: clip;
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; height: auto; display: block; }
a { color: var(--green-dark); text-decoration: none; }
a:hover { color: var(--green-dark); }
ul { list-style: none; }
button { font-family: inherit; }
h1, h2, h3, h4 { line-height: 1.25; color: var(--navy); font-weight: 700; }
p { color: var(--ink-soft); }
::selection { background: var(--green); color: var(--white); }
:focus-visible { outline: 3px solid var(--green); outline-offset: 2px; border-radius: 4px; }
section[id], header[id] { scroll-margin-top: calc(var(--header-h) + 16px); }
.container { width: 100%; max-width: var(--container); margin-inline: auto; padding-inline: clamp(18px, 4vw, 32px); }
.container--narrow { max-width: 860px; }
.sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
.icon { width: 20px; height: 20px; flex: none; display: inline-block; vertical-align: -0.25em; }
.skip-link { position: absolute; inset-inline-start: 12px; top: -60px; z-index: 200; background: var(--navy); color: var(--white); padding: 10px 18px; border-radius: 8px; transition: top 0.2s ease; }
.skip-link:focus { top: 12px; color: var(--white); }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 13px 26px; border: 2px solid transparent; border-radius: 999px; font-weight: 600; font-size: 0.98rem; line-height: 1.3; cursor: pointer; text-align: center; white-space: nowrap; transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}
.btn:hover { transform: translateY(-2px); }
.btn:active { transform: translateY(0); }
.btn--lg { padding: 15px 30px; font-size: 1.02rem; }
.btn--block { width: 100%; }
.btn--primary { background: var(--green-dark); color: var(--white); box-shadow: 0 8px 20px rgba(33, 140, 67, 0.28); }
.btn--primary:hover { background: #14592B; color: var(--white); }
.btn--accent { background: var(--white); color: var(--navy); box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18); }
.btn--accent:hover { background: var(--green-soft); color: var(--navy); }
.btn--wa { background: var(--wa); color: var(--white); box-shadow: 0 8px 20px rgba(18, 140, 126, 0.3); }
.btn--wa:hover { background: var(--wa-dark); color: var(--white); }
.btn--ghost { background: transparent; border-color: var(--green-dark); color: var(--green-dark); }
.btn--ghost:hover { background: var(--green-soft); color: var(--green-dark); }
.btn--outline-light { background: transparent; border-color: rgba(255, 255, 255, 0.6); color: var(--white); }
.btn--outline-light:hover { background: rgba(255, 255, 255, 0.12); color: var(--white); }
.btn__sub { flex-basis: 100%; text-align: center; font-size: 0.78rem; font-weight: 500; opacity: 0.9; margin-top: -2px; }

.topbar { background: var(--green-dark); color: var(--white); font-size: 0.85rem; padding-block: 7px; }
.topbar__inner { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
.topbar__contacts { display: flex; align-items: center; gap: clamp(12px, 3vw, 26px); flex-wrap: wrap; }
.topbar__link { display: inline-flex; align-items: center; gap: 8px; color: var(--white); opacity: 0.95; }
.topbar__link:hover { color: var(--white); opacity: 1; text-decoration: underline; }
.lang-switch { display: inline-flex; background: rgba(255, 255, 255, 0.16); border-radius: 999px; padding: 3px; gap: 3px; }
.lang-btn { border: 0; background: transparent; color: var(--white); font-size: 0.82rem; font-weight: 600; padding: 4px 14px; border-radius: 999px; cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease; }
.lang-btn:hover { background: rgba(255, 255, 255, 0.2); }
.lang-btn.is-active { background: var(--white); color: var(--green-dark); }

.site-header { position: sticky; top: 0; z-index: 100; background: var(--white); border-bottom: 1px solid transparent; transition: box-shadow 0.25s ease, border-color 0.25s ease; }
.site-header.is-stuck { border-color: var(--line); box-shadow: var(--shadow-sm); }
.site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: var(--header-h); }
.brand { display: inline-flex; align-items: center; }
.brand img { height: 46px; width: auto; }
.primary-nav { display: flex; align-items: center; gap: clamp(10px, 2vw, 26px); }
.primary-nav__list { display: flex; align-items: center; gap: clamp(6px, 1.6vw, 20px); }
.primary-nav__list a { display: inline-block; padding: 8px 4px; color: var(--ink); font-weight: 500; font-size: 0.97rem; position: relative; }
.primary-nav__list a::after { content: ""; position: absolute; inset-inline: 4px; bottom: 2px; height: 2.5px; background: var(--green); border-radius: 2px; transform: scaleX(0); transform-origin: center; transition: transform 0.25s ease; }
.primary-nav__list a:hover, .primary-nav__list a.is-current { color: var(--green-dark); }
.primary-nav__list a:hover::after, .primary-nav__list a.is-current::after { transform: scaleX(1); }
.nav-toggle { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 46px; height: 46px; border: 1px solid var(--line); border-radius: 12px; background: var(--white); cursor: pointer; padding: 11px; }
.nav-toggle__bar { display: block; height: 2.5px; width: 100%; background: var(--navy); border-radius: 2px; transition: transform 0.25s ease, opacity 0.2s ease; }
.site-header.is-open .nav-toggle__bar:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
.site-header.is-open .nav-toggle__bar:nth-child(2) { opacity: 0; }
.site-header.is-open .nav-toggle__bar:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

.hero { position: relative; background: linear-gradient(180deg, var(--neutral) 0%, var(--white) 90%); padding-block: clamp(48px, 7vw, 86px) clamp(56px, 8vw, 96px); overflow: clip; }
.hero__bg { position: absolute; inset: 0; pointer-events: none; }
.hero__blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.45; will-change: transform; }
.hero__blob--1 { width: 460px; height: 460px; background: #9BE3B4; top: -140px; inset-inline-start: -120px; animation: drift1 22s ease-in-out infinite alternate; }
.hero__blob--2 { width: 420px; height: 420px; background: #7FC6D8; bottom: -160px; inset-inline-end: 8%; opacity: 0.35; animation: drift2 26s ease-in-out infinite alternate; }
.hero__blob--3 { width: 300px; height: 300px; background: #CDEFD8; top: 30%; inset-inline-end: -80px; opacity: 0.5; animation: drift1 19s ease-in-out infinite alternate-reverse; }
@keyframes drift1 { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(50px, 34px, 0) scale(1.12); } }
@keyframes drift2 { from { transform: translate3d(0, 0, 0) scale(1.05); } to { transform: translate3d(-46px, -30px, 0) scale(0.95); } }
.hero__grid { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(30px, 5vw, 58px); align-items: center; }
.kicker { font-size: 0.86rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green-dark); margin-bottom: 14px; }
.kicker--on-dark { color: #7FE0A0; }
.kicker--on-light { color: var(--green-dark); }
.hero h1 { font-size: clamp(2rem, 4.4vw, 3.05rem); font-weight: 700; letter-spacing: -0.01em; }
.hero h1 em { font-style: normal; color: var(--green); white-space: nowrap; }
.hero__sub { margin-top: 18px; font-size: clamp(1rem, 1.4vw, 1.08rem); max-width: 56ch; }
.hero__points { margin-top: 24px; display: grid; gap: 12px; }
.hero__points li, .lead__points li, .why__points li { display: flex; align-items: flex-start; gap: 12px; font-weight: 500; color: var(--ink); }
.icon--check { width: 22px; height: 22px; color: var(--green); background: var(--green-soft); border-radius: 50%; padding: 3px; margin-top: 3px; }
.why__points li { color: rgba(255, 255, 255, 0.92); }
.why__points .icon--check { color: #7FE0A0; background: rgba(127, 224, 160, 0.16); }
.lead__points li { color: rgba(255, 255, 255, 0.92); }
.lead__points .icon--check { color: #7FE0A0; background: rgba(127, 224, 160, 0.16); }
.hero__actions { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 14px; }
.hero__media { position: relative; display: grid; grid-template-columns: 1.02fr 1fr; grid-template-rows: repeat(2, minmax(150px, 1fr)); gap: 14px; min-height: 440px; }
.hero__img { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); background: var(--neutral); }
.hero__img img { width: 100%; height: 100%; object-fit: cover; }
.hero__img--tall { grid-row: span 2; }
.hero__chip { position: absolute; bottom: -18px; inset-inline-end: 16px; background: var(--navy); color: var(--white); border-radius: 16px; padding: 12px 20px; box-shadow: var(--shadow-md); display: grid; gap: 2px; border: 1px solid rgba(255, 255, 255, 0.14); transition: transform 0.2s ease, background-color 0.2s ease; }
.hero__chip:hover { background: var(--green-dark); color: var(--white); transform: translateY(-3px); }
.hero__chip-label { font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.85; }
.hero__chip-phone { font-weight: 700; font-size: 1.1rem; }

.lead { background: radial-gradient(900px 400px at 85% -10%, rgba(33, 140, 67, 0.28), transparent 60%), radial-gradient(700px 500px at -10% 110%, rgba(14, 110, 126, 0.35), transparent 60%), var(--navy); color: var(--white); padding-block: clamp(56px, 8vw, 92px); }
.lead__grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
.lead h2 { color: var(--white); font-size: clamp(1.6rem, 3vw, 2.3rem); margin-bottom: 16px; }
.lead__intro p { color: rgba(255, 255, 255, 0.85); }
.lead__points { margin-top: 22px; display: grid; gap: 12px; }
.lead__direct { margin-top: 26px; font-size: 0.95rem; }
.lead__phone { display: inline-block; font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 700; color: var(--white); letter-spacing: 0.02em; }
.lead__phone:hover { color: #7FE0A0; }
.lead__form-wrap { background: var(--white); border-radius: var(--radius-lg); padding: clamp(22px, 3vw, 34px); box-shadow: 0 24px 60px rgba(0, 20, 28, 0.35); }
.quote-form__title { font-size: 1.25rem; margin-bottom: 18px; }
.field { display: grid; gap: 6px; margin-bottom: 14px; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.field label { font-size: 0.9rem; font-weight: 600; color: var(--navy); }
.req { color: var(--danger); }
.field input, .field textarea { font-family: inherit; font-size: 1rem; color: var(--ink); background: var(--white); border: 1.5px solid #D5DCD6; border-radius: 10px; padding: 11px 14px; width: 100%; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
.field textarea { resize: vertical; min-height: 110px; }
.field input:focus, .field textarea:focus { outline: none; border-color: var(--green); box-shadow: 0 0 0 3px rgba(33, 140, 67, 0.18); }
.field input[aria-invalid="true"], .field textarea[aria-invalid="true"] { border-color: var(--danger); background: #FDF3F2; }
.field-error { font-size: 0.82rem; color: var(--danger); min-height: 1.1em; font-weight: 500; }
.quote-form .btn { margin-top: 4px; }
.form-status { margin-top: 12px; font-size: 0.82rem; color: var(--ink-soft); line-height: 1.55; }
.form-status.is-success { color: var(--green-dark); font-weight: 500; }
.form-status.is-error { color: var(--danger); font-weight: 500; }
.approved { padding-block: clamp(34px, 5vw, 52px); background: var(--white); border-bottom: 1px solid var(--line); }
.section-title--sm { font-size: 1rem; letter-spacing: 0.16em; text-transform: uppercase; text-align: center; color: var(--ink-soft); font-weight: 600; margin-bottom: 24px; }
.approved__list { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: clamp(28px, 6vw, 64px); }
.approved__item img { height: clamp(46px, 6vw, 64px); width: auto; object-fit: contain; filter: saturate(0.92); }
.section { padding-block: clamp(56px, 8vw, 92px); }
.section--tint { background: var(--neutral); }
.section-head { max-width: 760px; margin-inline: auto; text-align: center; margin-bottom: clamp(30px, 4.5vw, 48px); }
.section-title { font-size: clamp(1.6rem, 3vw, 2.35rem); letter-spacing: -0.01em; }
.section-lead { margin-top: 14px; font-size: 1.03rem; }
.section-lead--start { text-align: start; }
.section-lead + .section-lead { margin-top: 10px; }
.card-grid { display: grid; gap: 20px; }
.card-grid--4 { grid-template-columns: repeat(4, 1fr); }
.card-grid--3 { grid-template-columns: repeat(3, 1fr); }
.card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px 24px; display: flex; flex-direction: column; gap: 10px; transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease; }
.card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); border-color: transparent; }
.card__badge { align-self: flex-start; background: var(--green-soft); color: var(--green-dark); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; }
.card h3 { font-size: 1.14rem; }
.card p { font-size: 0.95rem; flex-grow: 1; }
.card__link { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.93rem; color: var(--green-dark); margin-top: 4px; }
.card__link .arrow { display: inline-block; transition: transform 0.2s ease; }
.card__link:hover .arrow { transform: translateX(5px); }
[dir="rtl"] .card__link .arrow { transform: scaleX(-1); }
[dir="rtl"] .card__link:hover .arrow { transform: scaleX(-1) translateX(5px); }

.price-estimate { padding-top: clamp(56px,8vw,92px); }
.price-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
.price-card { background: var(--white); border: 1px solid var(--line); border-radius: 18px; padding: 28px 22px; display: flex; flex-direction: column; gap: 12px; box-shadow: var(--shadow-sm); }
.price-card__label { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green-dark); }
.price-card__value { font-size: clamp(1.7rem, 3vw, 2.4rem); color: var(--navy); line-height: 1.2; }
.price-note { margin-top: 24px; font-size: 1rem; color: var(--ink-soft); }

.stats__grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(34px, 5vw, 64px); align-items: center; }
.stats__media { position: relative; padding-bottom: 54px; }
.stats__img { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); background: var(--white); }
.stats__img img { width: 100%; height: 100%; object-fit: cover; }
.stats__img--main { aspect-ratio: 4 / 3; }
.stats__img--sub { position: absolute; bottom: 0; inset-inline-end: -6px; width: 46%; aspect-ratio: 1 / 1; border: 6px solid var(--white); }
.counters { display: grid; grid-template-columns: repeat(2, minmax(180px, 1fr)); gap: 22px; margin-top: 24px; }
.counter { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 20px 18px; display: flex; flex-direction: column; gap: 8px; }
.counter__num { font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; color: var(--navy); line-height: 1; }
.counter__label { font-size: 0.92rem; color: var(--ink-soft); }
.counter__label small { display: block; font-size: 0.78rem; color: var(--ink-soft); margin-top: 4px; }

.tile { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
.tile__media img { width: 100%; height: 220px; object-fit: cover; }
.tile__body { padding: 18px 18px 20px; }
.tile__body h3 { font-size: 1.1rem; margin-bottom: 8px; }
.tile__body p { font-size: 0.94rem; }

.pest-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
.pest { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 18px 16px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
.pest__icon { width: 56px; height: 56px; background: var(--green-soft); color: var(--green-dark); border-radius: 50%; display: grid; place-items: center; }
.pest__icon svg { width: 28px; height: 28px; }
.pest h3 { font-size: 1.02rem; }
.pest a { font-size: 0.85rem; font-weight: 600; color: var(--green-dark); }
.pests__cta { margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }

.why { background: linear-gradient(180deg, #00384B 0%, #002B3B 100%); color: var(--white); padding-block: clamp(56px, 8vw, 92px); }
.why__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(28px,5vw,54px); align-items: center; }
.why__content p { color: rgba(255,255,255,0.85); }
.why__content h2 { color: var(--white); font-size: clamp(1.6rem, 3vw, 2.3rem); margin-bottom: 16px; }
.why__cta { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius-lg); padding: clamp(22px, 3vw, 32px); }
.why__cta h3 { color: var(--white); font-size: 1.4rem; margin-bottom: 12px; }
.why__cta p { color: rgba(255,255,255,0.85); margin-bottom: 18px; }
.why__cta .btn--accent { margin-bottom: 12px; }

.contact-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 22px; display: flex; flex-direction: column; gap: 12px; }
.contact-card--accent { background: var(--green-soft); }
.contact-card__addr, .contact-card__phone { display: flex; align-items: flex-start; gap: 10px; }
.contact-card__addr svg, .contact-card__phone svg { margin-top: 3px; }

.sector-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
.sector { display: inline-flex; align-items: center; justify-content: center; background: var(--white); border: 1px solid var(--line); border-radius: 999px; padding: 11px 16px; font-weight: 600; color: var(--navy); }

.faq__list { display: grid; gap: 12px; }
.faq__item { background: var(--white); border: 1px solid var(--line); border-radius: 14px; padding: 0 18px; }
.faq__item summary { cursor: pointer; list-style: none; padding: 16px 0; font-weight: 600; color: var(--navy); }
.faq__item summary::-webkit-details-marker { display: none; }
.faq__body { padding: 0 0 18px; }
.faq__body p { color: var(--ink-soft); }

.final-cta { position: relative; background: var(--navy); color: var(--white); padding-block: clamp(56px, 8vw, 92px); overflow: hidden; }
.final-cta__bg { position: absolute; inset: 0; }
.final-cta__bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.18; }
.final-cta__inner { position: relative; z-index: 1; max-width: 720px; text-align: center; margin-inline: auto; }
.final-cta__text { color: rgba(255,255,255,0.85); margin-top: 12px; }
.final-cta__phone { display: inline-block; margin-top: 18px; font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 700; color: var(--white); }
.final-cta__actions { margin-top: 22px; display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; }

.site-footer { background: #f4f7f3; border-top: 1px solid var(--line); }
.site-footer__grid { display: grid; grid-template-columns: 1.2fr 0.8fr 0.8fr 1fr; gap: 32px; padding-block: clamp(28px, 4vw, 48px); }
.site-footer__brand p { margin-top: 16px; font-size: 0.96rem; }
.socials { display: flex; gap: 10px; margin-top: 16px; }
.socials a { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; background: var(--white); border: 1px solid var(--line); }
.site-footer__col h2 { font-size: 1.1rem; color: var(--navy); margin-bottom: 16px; }
.site-footer__col ul { display: grid; gap: 10px; }
.footer-contact { display: grid; gap: 12px; }
.footer-contact li { display: flex; align-items: flex-start; gap: 10px; }
.site-footer__bottom { background: var(--white); border-top: 1px solid var(--line); }
.site-footer__bottom .container { padding-block: 18px; }
.site-footer__bottom p { color: var(--ink-soft); font-size: 0.92rem; }

.wa-float { position: fixed; right: 18px; bottom: 18px; width: 60px; height: 60px; display: grid; place-items: center; border-radius: 50%; background: var(--wa); color: var(--white); box-shadow: 0 16px 36px rgba(14, 110, 98, 0.35); z-index: 150; }
.wa-float .icon { width: 28px; height: 28px; }

@media (max-width: 980px) {
  .hero__grid, .lead__grid, .why__grid, .stats__grid, .site-footer__grid { grid-template-columns: 1fr; }
  .pest-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .card-grid--4 { grid-template-columns: repeat(2, 1fr); }
  .card-grid--3 { grid-template-columns: 1fr; }
  .price-grid { grid-template-columns: 1fr; }
  .primary-nav { width: 100%; justify-content: space-between; }
}

@media (max-width: 700px) {
  .nav-toggle { display: flex; }
  .primary-nav { display: none; }
  .site-header.is-open .primary-nav { display: flex; position: absolute; left: 18px; right: 18px; top: calc(100% + 8px); background: var(--white); border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow-sm); padding: 14px 16px; flex-direction: column; align-items: stretch; }
  .primary-nav__list { flex-direction: column; align-items: flex-start; width: 100%; }
  .primary-nav__list a { width: 100%; }
  .pest-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .counters { grid-template-columns: 1fr; }
  .field-row { grid-template-columns: 1fr; }
}

@media (max-width: 480px) {
  .pest-grid { grid-template-columns: 1fr; }
  .card-grid--4 { grid-template-columns: 1fr; }
  .hero__media { min-height: 360px; }
}
